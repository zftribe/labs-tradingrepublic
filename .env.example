# Supabase — from your project's API settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose with a NEXT_PUBLIC_ prefix or in client code.
# Used for admin author invites + role changes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for OG tags, sitemap, invite redirect).
# Local dev: http://localhost:3000  ·  Prod: https://labs.tradingrepublic.io
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only public teaser handoff. Leave blank to keep delivery off.
# The owner sets the same signing secret on this host and on the downstream
# bot host. Never put a chat bot token here, and never commit a real secret.
FM_LABS_EVENT_SECRET=
# HTTPS origin of the owner-approved intake. No user, password, query, or fragment.
# The website posts to <origin>/v1/labs-events. No address is configured in git.
LABS_MIRROR_URL=
# Must be the exact string true before an admin may queue the one catch-up.
# Queuing does not send. Default off.
LABS_MIRROR_CATCHUP_ENABLED=
